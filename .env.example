# ==============================================================================
# SkipIt 3.0 Production Environment Configuration Template
# Strictly Zero-Commission P2P Marketplace (No Payment Gateways)
# ==============================================================================

# 1. Supabase (PostgreSQL & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 2. Backend & Real-Time WebSocket Server
PORT=5000
WS_PORT=5001
NODE_ENV=production
JWT_SECRET=generate_a_minimum_32_character_random_hex_or_alphanumeric_secret
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
ENABLE_DEV_OTP=false

# Google OAuth Client IDs (comma-separated: web, android, ios client IDs)
GOOGLE_CLIENT_IDS=your_web_client_id.apps.googleusercontent.com,your_android_client_id.apps.googleusercontent.com,your_ios_client_id.apps.googleusercontent.com

# 3. Web Frontend (Next.js - Fixed at build time)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# 4. SMS Provider (Choose: mock, msg91, twilio, fast2sms)
SMS_PROVIDER=mock
# MSG91 (if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Fast2SMS (if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# 5. Firebase Cloud Messaging (Push Notifications - file path or raw JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=./config/firebase-service-account.json

# 6. Mobile Application (Flutter Build Defines)
# Pass via --dart-define during build:
# flutter build apk --release --dart-define=API_BASE_URL=https://api.yourdomain.com/api/v1 --dart-define=WS_URL=wss://api.yourdomain.com
