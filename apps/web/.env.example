# ==============================================================================
# SkipIt 3.0 Web Application Environment Configuration Template
# (Inlined by Next.js at build time via NEXT_PUBLIC_ prefix)
# ==============================================================================

# Backend API & WebSocket URLs
NEXT_PUBLIC_API_URL=https://api.skipit.example.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.skipit.example.com

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Google OAuth Client ID for Web Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
