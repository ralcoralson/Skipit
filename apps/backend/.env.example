# ==============================================================================
# SkipIt 3.0 Backend Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=5000
WS_PORT=5001
NODE_ENV=production

# Security & Secrets (JWT_SECRET must be >= 32 characters in production)
JWT_SECRET=generate_a_minimum_32_character_random_hex_or_alphanumeric_secret
CORS_ORIGIN=https://skipit.example.com,https://api.skipit.example.com

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Google OAuth 2.0 Client IDs (comma-separated: web, android, ios client IDs)
GOOGLE_CLIENT_IDS=your_web_client_id.apps.googleusercontent.com,your_android_client_id.apps.googleusercontent.com,your_ios_client_id.apps.googleusercontent.com

# Developer OTP (set true ONLY in non-production environments to echo OTP in API responses)
ENABLE_DEV_OTP=false

# SMS Provider (mock | msg91 | twilio | fast2sms)
SMS_PROVIDER=mock
# MSG91 (if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Fast2SMS (if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# Firebase Cloud Messaging Admin SDK (Single env var: filepath or raw JSON string)
# e.g. FIREBASE_SERVICE_ACCOUNT_JSON=./config/firebase-service-account.json
# or raw JSON: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":...}
FIREBASE_SERVICE_ACCOUNT_JSON=./config/firebase-service-account.json
